{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build paper locally",
      "type": "process",
      "command": "/bin/bash",
      "args": ["${workspaceFolder}/scripts/build-paper.sh"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Auto commit and push (10 min)",
      "type": "process",
      "command": "/usr/bin/python3",
      "args": ["-u", "${workspaceFolder}/scripts/auto-git-sync.py", "--watch", "--interval", "600"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "silent",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
